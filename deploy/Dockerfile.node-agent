FROM golang:1.25-alpine AS builder

RUN apk add --no-cache git

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /wwvpn-node-agent ./cmd/node-agent

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=builder /wwvpn-node-agent /usr/local/bin/wwvpn-node-agent

EXPOSE 50051
ENTRYPOINT ["wwvpn-node-agent"]
