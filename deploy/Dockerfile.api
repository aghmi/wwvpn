FROM golang:1.25-alpine AS builder

RUN apk add --no-cache git

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /wwvpn-api ./cmd/api

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=builder /wwvpn-api /usr/local/bin/wwvpn-api
COPY config.yaml /etc/wwvpn/config.yaml

EXPOSE 8080
CMD ["wwvpn-api"]
